{"activities":[{"en":"Sleeping","id":"sleep","system":false,"zh":"睡觉"},{"en":"Having a meal","id":"meal","system":false,"zh":"用饭"},{"en":"Working","id":"work","system":false,"zh":"干活"},{"en":"Having tea","id":"tea","system":false,"zh":"喝茶"},{"en":"Drinking","id":"drink","system":false,"zh":"喝酒"},{"en":"Chatting","id":"chat","system":false,"zh":"闲谈"},{"en":"Praying","id":"pray","system":false,"zh":"上香"},{"en":"Teaching","id":"teach","system":false,"zh":"教书"},{"en":"Studying","id":"study","system":false,"zh":"读书"},{"en":"Playing","id":"play","system":false,"zh":"玩耍"},{"en":"Fishing","id":"fish","system":false,"zh":"钓鱼"},{"en":"Ferrying","id":"ferry","system":false,"zh":"摆渡"},{"en":"On the night round","id":"patrol","system":false,"zh":"巡夜"},{"en":"In council","id":"council","system":false,"zh":"议事"},{"en":"Resting","id":"rest","system":false,"zh":"歇息"},{"en":"Walking","id":"walk","system":true,"zh":"赶路"},{"en":"Carrying a load","id":"carry","system":true,"zh":"搬运"},{"en":"Sheltering from the rain","id":"shelter","system":true,"zh":"躲雨"}],"families":[{"en":"Li Family","id":"fam_li","zh":"李家"},{"en":"Zhou Family","id":"fam_zhou","zh":"周家"}],"id":"bridge_v0","items":[{"en":"Bamboo","id":"bamboo","zh":"竹料"},{"en":"Timber","id":"timber","zh":"木料"},{"en":"Tools","id":"tools","zh":"工具"}],"people":[{"bio":{"en":"Granny Li has been a widow for many years and raised her two sons, Li Da and Li Er, on her own, and now has her grandchildren about her. Nothing large is decided in the Li house until she nods.","zh":"李老太守寡多年，一手把李大、李二两个儿子拉扯大，如今孙女孙子都在跟前。李家的大事，最后都要她点头。"},"en":"Granny Li","family":"fam_li","holdings":[],"home":"p_li_house","id":"li_laotai","night_shift":false,"ops":{"assimilate":40,"fill":15,"level":20,"sharpen":25},"role":{"en":"Matriarch of the Li family","zh":"李家老太太"},"routine":[{"act":"meal","hour":6,"place":"p_li_house"},{"act":"pray","hour":7,"place":"p_temple"},{"act":"rest","hour":9,"place":"p_li_house"},{"act":"meal","hour":12,"place":"p_li_house"},{"act":"rest","hour":13,"place":"p_li_house"},{"act":"tea","hour":15,"place":"p_teahouse"},{"act":"meal","hour":19,"place":"p_li_house"},{"act":"sleep","hour":21,"place":"p_li_house"}],"tags":[],"token":{"en":"L","zh":"李"},"traits":{"conformity":70,"gossip":35,"suspicion":60,"warmth":55},"work":"p_li_house","zh":"李老太"},{"bio":{"en":"Li Da is Granny Li's elder son and has charge of the family's bamboo grove and its bamboo. He is steady, and on anything big he waits for his mother's word.","zh":"李大是李老太的长子，家里的竹林和竹料归他管。他做事稳当，可大事向来要等娘发话。"},"en":"Li Da","family":"fam_li","holdings":[{"at":"p_li_house","item":"bamboo","qty":30}],"home":"p_li_house","id":"li_da","night_shift":false,"ops":{"assimilate":35,"fill":15,"level":25,"sharpen":25},"role":{"en":"Eldest Li son, keeper of the bamboo","zh":"李家长子，管竹料"},"routine":[{"act":"meal","hour":6,"place":"p_li_house"},{"act":"work","hour":7,"place":"p_li_house"},{"act":"work","hour":11,"place":"p_market"},{"act":"meal","hour":13,"place":"p_li_house"},{"act":"work","hour":14,"place":"p_li_house"},{"act":"tea","hour":16,"place":"p_teahouse"},{"act":"rest","hour":20,"place":"p_li_house"},{"act":"sleep","hour":21,"place":"p_li_house"}],"tags":[],"token":{"en":"L","zh":"李"},"traits":{"conformity":55,"gossip":40,"suspicion":45,"warmth":50},"work":"p_li_house","zh":"李大"},{"bio":{"en":"Li Er is Granny Li's younger son and works at the lantern workshop, where the lanterns he pastes come out round and bright. He is easygoing and has a word for everyone in town, young or old.","zh":"李二是李老太的小儿子，在扎灯坊帮工，糊出来的灯又圆又亮。他脾气随和，镇上老老少少都和他说得上话。"},"en":"Li Er","family":"fam_li","holdings":[],"home":"p_li_house","id":"li_er","night_shift":false,"ops":{"assimilate":25,"fill":25,"level":30,"sharpen":20},"role":{"en":"Second Li son","zh":"李家次子"},"routine":[{"act":"meal","hour":6,"place":"p_li_house"},{"act":"work","hour":7,"place":"p_workshop"},{"act":"meal","hour":12,"place":"p_li_house"},{"act":"work","hour":13,"place":"p_workshop"},{"act":"chat","hour":17,"place":"p_bridge"},{"act":"meal","hour":19,"place":"p_li_house"},{"act":"rest","hour":20,"place":"p_li_house"},{"act":"sleep","hour":21,"place":"p_li_house"}],"tags":[],"token":{"en":"L","zh":"李"},"traits":{"conformity":40,"gossip":45,"suspicion":35,"warmth":55},"work":"p_workshop","zh":"李二"},{"bio":{"en":"Shitou is Li Da's young son. He spends the day at the school and runs to the riverbank the moment lessons end. He is loud and cannot keep anything to himself.","zh":"石头是李大的小儿子，白天在私塾念书，一下学就往河滩跑。他嗓门大，心里藏不住话。"},"en":"Shitou","family":"fam_li","holdings":[],"home":"p_li_house","id":"shitou","night_shift":false,"ops":{"assimilate":15,"fill":20,"level":40,"sharpen":25},"role":{"en":"Child of the Li family","zh":"李家的孩子"},"routine":[{"act":"meal","hour":6,"place":"p_li_house"},{"act":"study","hour":8,"place":"p_school"},{"act":"meal","hour":12,"place":"p_li_house"},{"act":"study","hour":13,"place":"p_school"},{"act":"play","hour":16,"place":"p_riverbank"},{"act":"meal","hour":18,"place":"p_li_house"},{"act":"rest","hour":20,"place":"p_li_house"},{"act":"sleep","hour":21,"place":"p_li_house"}],"tags":[],"token":{"en":"L","zh":"李"},"traits":{"conformity":30,"gossip":55,"suspicion":15,"warmth":80},"work":"p_school","zh":"石头"},{"bio":{"en":"Li Xiaomei is Li Da's daughter and often helps at the lantern workshop, cutting paper and pasting shades. She is deft and sweet-tongued, and the neighbours are fond of her.","zh":"李家小妹是李大的女儿，常去扎灯坊帮着裁纸、糊灯面。她手巧嘴甜，街坊都喜欢她。"},"en":"Li Xiaomei","family":"fam_li","holdings":[],"home":"p_li_house","id":"li_xiaomei","night_shift":false,"ops":{"assimilate":20,"fill":40,"level":30,"sharpen":10},"role":{"en":"Youngest daughter of the Li family","zh":"李家小女儿"},"routine":[{"act":"meal","hour":6,"place":"p_li_house"},{"act":"work","hour":7,"place":"p_workshop"},{"act":"meal","hour":12,"place":"p_li_house"},{"act":"work","hour":13,"place":"p_workshop"},{"act":"chat","hour":17,"place":"p_riverbank"},{"act":"rest","hour":19,"place":"p_li_house"},{"act":"sleep","hour":21,"place":"p_li_house"}],"tags":["bridge"],"token":{"en":"L","zh":"李"},"traits":{"conformity":35,"gossip":60,"suspicion":25,"warmth":80},"work":"p_workshop","zh":"李家小妹"},{"bio":{"en":"Shopkeeper Zhou has traded in timber for half his life, and most of the timber a repair would need sits in his store. To him, favours and business are kept in two separate ledgers.","zh":"周掌柜做了半辈子木料生意，修桥要的木料大半在他家库里。在他那里，人情和买卖是两本账。"},"en":"Shopkeeper Zhou","family":"fam_zhou","holdings":[{"at":"p_zhou_house","item":"timber","qty":24}],"home":"p_zhou_house","id":"zhou_zhanggui","night_shift":false,"ops":{"assimilate":40,"fill":20,"level":15,"sharpen":25},"role":{"en":"Head of the Zhou shop, keeper of the timber","zh":"周家掌柜，管木料"},"routine":[{"act":"meal","hour":6,"place":"p_zhou_house"},{"act":"work","hour":7,"place":"p_zhou_house"},{"act":"work","hour":10,"place":"p_market"},{"act":"meal","hour":12,"place":"p_zhou_house"},{"act":"work","hour":13,"place":"p_zhou_house"},{"act":"tea","hour":17,"place":"p_teahouse"},{"act":"meal","hour":19,"place":"p_zhou_house"},{"act":"sleep","hour":21,"place":"p_zhou_house"}],"tags":[],"token":{"en":"Z","zh":"周"},"traits":{"conformity":60,"gossip":50,"suspicion":65,"warmth":35},"work":"p_zhou_house","zh":"周掌柜"},{"bio":{"en":"Madam Zhou is the Shopkeeper's wife and is out at the market every day. When anything happens in any house on the street, she is the first to hear of it and the first to tell it.","zh":"周娘子是周掌柜的妻子，天天在集市上走动。街坊谁家有点事，她总是头一个知道，也头一个说出去。"},"en":"Madam Zhou","family":"fam_zhou","holdings":[],"home":"p_zhou_house","id":"zhou_niangzi","night_shift":false,"ops":{"assimilate":30,"fill":20,"level":20,"sharpen":30},"role":{"en":"Mistress of the Zhou household","zh":"周家主妇"},"routine":[{"act":"meal","hour":6,"place":"p_zhou_house"},{"act":"work","hour":7,"place":"p_market"},{"act":"meal","hour":11,"place":"p_zhou_house"},{"act":"rest","hour":13,"place":"p_zhou_house"},{"act":"pray","hour":15,"place":"p_temple"},{"act":"chat","hour":17,"place":"p_teahouse"},{"act":"meal","hour":19,"place":"p_zhou_house"},{"act":"sleep","hour":21,"place":"p_zhou_house"}],"tags":[],"token":{"en":"Z","zh":"周"},"traits":{"conformity":60,"gossip":70,"suspicion":50,"warmth":50},"work":"p_market","zh":"周娘子"},{"bio":{"en":"Zhou Dalang is the Shopkeeper's elder son and carries timber and runs errands for the family trade. He is strong and short-tempered, and spends his free hours at the tavern.","zh":"周家大郎是周掌柜的长子，帮家里扛木料、跑买卖。他力气大，脾气也大，闲下来就往酒肆跑。"},"en":"Zhou Dalang","family":"fam_zhou","holdings":[],"home":"p_zhou_house","id":"zhou_dalang","night_shift":false,"ops":{"assimilate":25,"fill":20,"level":10,"sharpen":45},"role":{"en":"Eldest Zhou son, quick to anger","zh":"周家长子，脾气爆"},"routine":[{"act":"sleep","hour":6,"place":"p_zhou_house"},{"act":"meal","hour":9,"place":"p_zhou_house"},{"act":"work","hour":10,"place":"p_zhou_house"},{"act":"meal","hour":13,"place":"p_tavern"},{"act":"work","hour":14,"place":"p_zhou_house"},{"act":"rest","hour":17,"place":"p_zhou_house"},{"act":"drink","hour":18,"place":"p_tavern"},{"act":"sleep","hour":22,"place":"p_zhou_house"}],"tags":[],"token":{"en":"Z","zh":"周"},"traits":{"conformity":20,"gossip":45,"suspicion":40,"warmth":30},"work":"p_zhou_house","zh":"周家大郎"},{"bio":{"en":"Zhou Erlang is the Shopkeeper's younger son, mild by nature, and often sent to the market and the river on family errands. However hard the two families quarrel, he still greets the Li family when he meets them.","zh":"周家二郎是周掌柜的次子，性子温和，常替家里去集市、河边办事。两家吵得再凶，他见了李家人也照样问好。"},"en":"Zhou Erlang","family":"fam_zhou","holdings":[],"home":"p_zhou_house","id":"zhou_erlang","night_shift":false,"ops":{"assimilate":20,"fill":40,"level":30,"sharpen":10},"role":{"en":"Second Zhou son","zh":"周家次子"},"routine":[{"act":"meal","hour":6,"place":"p_zhou_house"},{"act":"work","hour":7,"place":"p_zhou_house"},{"act":"meal","hour":12,"place":"p_zhou_house"},{"act":"work","hour":13,"place":"p_market"},{"act":"chat","hour":17,"place":"p_riverbank"},{"act":"rest","hour":19,"place":"p_zhou_house"},{"act":"sleep","hour":21,"place":"p_zhou_house"}],"tags":["bridge"],"token":{"en":"Z","zh":"周"},"traits":{"conformity":30,"gossip":55,"suspicion":30,"warmth":75},"work":"p_zhou_house","zh":"周家二郎"},{"bio":{"en":"Zhou's Clerk has worked for the Zhou family for years, with a good memory and quick hands. Whatever comes up, his first words are that the Shopkeeper decides.","zh":"伙计在周家帮工好些年，记性好，手脚勤快。遇上什么事，他一开口总是「掌柜的说了算」。"},"en":"Zhou's Clerk","family":"fam_zhou","holdings":[],"home":"p_zhou_house","id":"zhou_huoji","night_shift":false,"ops":{"assimilate":30,"fill":20,"level":30,"sharpen":20},"role":{"en":"Works for the Zhou family","zh":"在周家帮工"},"routine":[{"act":"meal","hour":6,"place":"p_zhou_house"},{"act":"work","hour":7,"place":"p_zhou_house"},{"act":"work","hour":10,"place":"p_market"},{"act":"meal","hour":12,"place":"p_teahouse"},{"act":"work","hour":13,"place":"p_zhou_house"},{"act":"tea","hour":17,"place":"p_teahouse"},{"act":"meal","hour":19,"place":"p_zhou_house"},{"act":"sleep","hour":21,"place":"p_zhou_house"}],"tags":[],"token":{"en":"Z","zh":"周"},"traits":{"conformity":75,"gossip":65,"suspicion":40,"warmth":45},"work":"p_zhou_house","zh":"周家伙计"},{"bio":{"en":"The Teahouse Keeper has kept the teahouse by the river for more than ten years, and every piece of news in town passes over her tables. What leaves her teahouse has usually gained some colour on the way.","zh":"老板娘在河边守着茶馆十几年，镇上的新鲜事都要在她的茶桌上过一遍。话从她这里传出去，往往又多了几分颜色。"},"en":"Teahouse Keeper","family":null,"holdings":[],"home":"p_teahouse","id":"cha_laoban","night_shift":false,"ops":{"assimilate":25,"fill":20,"level":10,"sharpen":45},"role":{"en":"Keeper of the teahouse","zh":"茶馆老板娘"},"routine":[{"act":"meal","hour":6,"place":"p_teahouse"},{"act":"work","hour":7,"place":"p_teahouse"},{"act":"meal","hour":12,"place":"p_teahouse"},{"act":"work","hour":13,"place":"p_teahouse"},{"act":"sleep","hour":21,"place":"p_teahouse"}],"tags":["hub"],"token":{"en":"T","zh":"茶"},"traits":{"conformity":55,"gossip":92,"suspicion":40,"warmth":70},"work":"p_teahouse","zh":"茶馆老板娘"},{"bio":{"en":"The Schoolmaster teaches the town's children to read and write, and puts out the Town Gazette. Once a thing is in the Gazette, those who can read take it as true.","zh":"私塾先生教镇上的孩子读书识字，还办着一份《镇报》。镇上的事一上了《镇报》，识字的人就当了真。"},"en":"Schoolmaster","family":null,"holdings":[],"home":"p_school","id":"sishu_xiansheng","night_shift":false,"ops":{"assimilate":20,"fill":35,"level":35,"sharpen":10},"role":{"en":"Schoolmaster, editor of the Town Gazette","zh":"私塾先生，办《镇报》"},"routine":[{"act":"meal","hour":6,"place":"p_school"},{"act":"teach","hour":8,"place":"p_school"},{"act":"meal","hour":12,"place":"p_school"},{"act":"teach","hour":13,"place":"p_school"},{"act":"tea","hour":16,"place":"p_teahouse"},{"act":"study","hour":18,"place":"p_school"},{"act":"rest","hour":20,"place":"p_school"},{"act":"sleep","hour":21,"place":"p_school"}],"tags":["hub"],"token":{"en":"S","zh":"塾"},"traits":{"conformity":40,"gossip":70,"suspicion":35,"warmth":55},"work":"p_school","zh":"私塾先生"},{"bio":{"en":"Boatman He has run the ferry for more than twenty years, and everyone in town has crossed in his boat. The boatman sees a great deal of what happens on the river and says little of it.","zh":"老何在渡口摆了二十多年渡船，镇上的人谁都坐过他的船。河上的事他看得多，说得少。"},"en":"Boatman He","family":null,"holdings":[],"home":"p_he_home","id":"old_he","night_shift":false,"ops":{"assimilate":20,"fill":30,"level":30,"sharpen":20},"role":{"en":"Ferryman","zh":"摆渡船夫"},"routine":[{"act":"meal","hour":6,"place":"p_he_home"},{"act":"ferry","hour":7,"place":"p_ferry"},{"act":"meal","hour":12,"place":"p_he_home"},{"act":"ferry","hour":13,"place":"p_ferry"},{"act":"rest","hour":17,"place":"p_he_home"},{"act":"tea","hour":18,"place":"p_teahouse"},{"act":"rest","hour":20,"place":"p_he_home"},{"act":"sleep","hour":21,"place":"p_he_home"}],"tags":["bridge"],"token":{"en":"H","zh":"何"},"traits":{"conformity":45,"gossip":40,"suspicion":55,"warmth":50},"work":"p_ferry","zh":"船夫老何"},{"bio":{"en":"The Clan Elder is the most senior elder in Chengxi, and the ancestral hall and the clan's rules are his to keep. Bringing in an outsider to manage this year's festival was his decision.","zh":"族长是澄溪镇辈分最高的长辈，祠堂的事和族里的规矩都由他定。这回请外乡人来当灯会总管，也是他拍的板。"},"en":"Clan Elder","family":null,"holdings":[],"home":"p_clan_hall","id":"zuzhang","night_shift":false,"ops":{"assimilate":35,"fill":10,"level":50,"sharpen":5},"role":{"en":"Elder of the clan","zh":"族长"},"routine":[{"act":"meal","hour":6,"place":"p_clan_hall"},{"act":"council","hour":8,"place":"p_clan_hall"},{"act":"meal","hour":12,"place":"p_clan_hall"},{"act":"council","hour":13,"place":"p_clan_hall"},{"act":"pray","hour":16,"place":"p_temple"},{"act":"tea","hour":17,"place":"p_teahouse"},{"act":"meal","hour":19,"place":"p_clan_hall"},{"act":"sleep","hour":21,"place":"p_clan_hall"}],"tags":["gatekeeper"],"token":{"en":"C","zh":"族"},"traits":{"conformity":85,"gossip":15,"suspicion":50,"warmth":45},"work":"p_clan_hall","zh":"族长"},{"bio":{"en":"The Accountant keeps the town's common accounts. Every coin spent on bridges, roads and the festival is written down in his ledger.","zh":"账房先生管着全镇的公账。修桥修路、灯会的花销，一笔一笔都记在他的账本上。"},"en":"Accountant","family":null,"holdings":[],"home":"p_accountant_home","id":"zhangfang","night_shift":false,"ops":{"assimilate":15,"fill":20,"level":60,"sharpen":5},"role":{"en":"Keeper of the town's accounts","zh":"账房先生"},"routine":[{"act":"meal","hour":6,"place":"p_accountant_home"},{"act":"work","hour":8,"place":"p_market"},{"act":"meal","hour":12,"place":"p_accountant_home"},{"act":"work","hour":13,"place":"p_market"},{"act":"rest","hour":17,"place":"p_accountant_home"},{"act":"sleep","hour":21,"place":"p_accountant_home"}],"tags":["gatekeeper"],"token":{"en":"A","zh":"账"},"traits":{"conformity":60,"gossip":10,"suspicion":70,"warmth":35},"work":"p_market","zh":"账房"},{"bio":{"en":"The Temple Keeper has tended the incense of the town's small temple for most of her life. The lane behind the temple is usually locked, and she keeps the key.","zh":"庙祝在镇上的小庙里守了大半辈子香火。庙后那条夹道平日锁着，钥匙由她收着。"},"en":"Temple Keeper","family":null,"holdings":[],"home":"p_temple","id":"miaozhu","night_shift":false,"ops":{"assimilate":30,"fill":20,"level":40,"sharpen":10},"role":{"en":"Keeper of the temple","zh":"庙祝"},"routine":[{"act":"pray","hour":6,"place":"p_temple"},{"act":"work","hour":8,"place":"p_temple"},{"act":"meal","hour":12,"place":"p_temple"},{"act":"work","hour":13,"place":"p_temple"},{"act":"work","hour":17,"place":"p_temple_lane"},{"act":"meal","hour":19,"place":"p_temple"},{"act":"sleep","hour":21,"place":"p_temple"}],"tags":["gatekeeper"],"token":{"en":"K","zh":"庙"},"traits":{"conformity":70,"gossip":20,"suspicion":40,"warmth":60},"work":"p_temple","zh":"庙祝"},{"bio":{"en":"Xiaoman lives by the river, often fishes alone on the bank at night, and dozes through the day. The grown-ups mostly hear what Xiaoman says as a child's talk.","zh":"小满家就在河边，夜里常一个人蹲在河滩钓鱼，白天就犯困。小满说的话，大人们多半当孩子话听。"},"en":"Xiaoman","family":null,"holdings":[],"home":"p_xiaoman_home","id":"xiao_man","night_shift":true,"ops":{"assimilate":10,"fill":20,"level":45,"sharpen":25},"role":{"en":"A child who likes to fish at night","zh":"夜里爱钓鱼的孩子"},"routine":[{"act":"sleep","hour":6,"place":"p_xiaoman_home"},{"act":"meal","hour":9,"place":"p_xiaoman_home"},{"act":"fish","hour":10,"place":"p_riverbank"},{"act":"meal","hour":13,"place":"p_xiaoman_home"},{"act":"play","hour":14,"place":"p_market"},{"act":"meal","hour":17,"place":"p_xiaoman_home"},{"act":"rest","hour":19,"place":"p_xiaoman_home"},{"act":"fish","hour":21,"place":"p_riverbank"},{"act":"sleep","hour":23,"place":"p_xiaoman_home"}],"tags":["witness"],"token":{"en":"X","zh":"满"},"traits":{"conformity":25,"gossip":60,"suspicion":20,"warmth":70},"work":"p_riverbank","zh":"小满"},{"bio":{"en":"The Night Watchman has walked his rounds for more than ten years, along the river and over the stone bridge, calling the hours on his gong. He likes a drink, and the town says that what he sees at night should be taken with some doubt.","zh":"更夫打了十几年更，每夜提着锣沿河岸、过石桥报时。他爱喝两口，镇上人都说他夜里看见的事要打个折扣。"},"en":"Night Watchman","family":null,"holdings":[],"home":"p_watch_post","id":"gengfu","night_shift":true,"ops":{"assimilate":15,"fill":25,"level":30,"sharpen":30},"role":{"en":"Night watchman, fond of a drink","zh":"爱喝酒的更夫"},"routine":[{"act":"sleep","hour":6,"place":"p_watch_post"},{"act":"meal","hour":14,"place":"p_watch_post"},{"act":"rest","hour":15,"place":"p_watch_post"},{"act":"meal","hour":18,"place":"p_watch_post"},{"act":"rest","hour":20,"place":"p_watch_post"},{"act":"patrol","hour":21,"place":"p_bridge"},{"act":"patrol","hour":23,"place":"p_ferry"},{"act":"patrol","hour":1,"place":"p_market"},{"act":"patrol","hour":3,"place":"p_bridge"},{"act":"rest","hour":5,"place":"p_watch_post"}],"tags":["witness"],"token":{"en":"W","zh":"更"},"traits":{"conformity":40,"gossip":50,"suspicion":55,"warmth":40},"work":"p_bridge","zh":"更夫"},{"bio":{"en":"The Carpenter keeps a bench in the lantern workshop, and the town brings him every broken door, window and chair. Any repair to the bridge that needs timber will need his hands.","zh":"木匠在扎灯坊里有一张工台，镇上门窗桌椅坏了都找他。修桥要动木头，少不了他的手艺。"},"en":"Carpenter","family":null,"holdings":[{"at":"p_workshop","item":"tools","qty":3}],"home":"p_carpenter_home","id":"mujiang","night_shift":false,"ops":{"assimilate":25,"fill":25,"level":35,"sharpen":15},"role":{"en":"Carpenter","zh":"木匠"},"routine":[{"act":"meal","hour":6,"place":"p_carpenter_home"},{"act":"work","hour":7,"place":"p_workshop"},{"act":"meal","hour":12,"place":"p_carpenter_home"},{"act":"work","hour":13,"place":"p_workshop"},{"act":"tea","hour":17,"place":"p_teahouse"},{"act":"meal","hour":19,"place":"p_carpenter_home"},{"act":"sleep","hour":21,"place":"p_carpenter_home"}],"tags":[],"token":{"en":"C","zh":"木"},"traits":{"conformity":50,"gossip":35,"suspicion":40,"warmth":55},"work":"p_workshop","zh":"木匠"},{"bio":{"en":"The Lantern Maker has made lanterns for thirty years, and the great lantern at the head of every parade is her work. This year's lanterns are half made, waiting for the night of the parade.","zh":"扎灯师傅扎了三十年灯，每年游灯打头的那盏主灯都出自她手。今年的灯已经扎了一半，就等游灯那一夜。"},"en":"Lantern Maker","family":null,"holdings":[],"home":"p_workshop","id":"zhadeng_shifu","night_shift":false,"ops":{"assimilate":20,"fill":30,"level":35,"sharpen":15},"role":{"en":"Master of the lantern workshop","zh":"扎灯师傅"},"routine":[{"act":"meal","hour":6,"place":"p_workshop"},{"act":"work","hour":7,"place":"p_workshop"},{"act":"meal","hour":12,"place":"p_workshop"},{"act":"work","hour":13,"place":"p_workshop"},{"act":"meal","hour":19,"place":"p_workshop"},{"act":"rest","hour":20,"place":"p_workshop"},{"act":"sleep","hour":21,"place":"p_workshop"}],"tags":[],"token":{"en":"M","zh":"灯"},"traits":{"conformity":45,"gossip":30,"suspicion":30,"warmth":60},"work":"p_workshop","zh":"扎灯师傅"}],"scenario":"bridge","script":"broken_bridge","size":20}